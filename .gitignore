node_modules
.pnpm-store
.DS_Store
*.log
packages/*/node_modules
*.tsbuildinfo
coverage
dist

# Environment files — all variants, keep only .env.example if one exists
.env*
!.env.example

# IDE
/.idea
/.vscode/*
!.vscode/extensions.json

# Build output
build/
_build
*/build-assets
*/build-chunks
.rsdoctor

# Playwright
/test-results/
/playwright-report/
.playwright-mcp/

# Local runtime secrets (never commit)
settings.json

# Local PM2 process config (machine-specific paths, never commit)
ecosystem.config.cjs

# Local Vite config override (never commit — overrides vite.config.ts in CI)
vite.config.js

# Misc local artifacts
my-submodule/*
.gitmodules
.meteor/local
**/.meteor/local-test/
current.md
pollenate-test-*.png

# Meteor build output and local packages
meteor-backend/prod-build/
meteor-backend/packages/
meteor-backend/.meteor/local/
meteor-backend/.meteor/local-test/

# Local development scripts and configs (machine-specific, never commit)
backend/nginx-apple-proxy.conf
meteor-backend/start-rosetta.sh

# vendor/ui is a submodule (see .gitmodules); its build output is packed into
# the committed vendor/mieweb-ui.tgz. Only the pack's leftovers are ignored.
vendor/ui/*.tgz

# Database backups (migration and production backups)
backups/
prod-backups/
backend/
backups/

# PulseVault + general uploaded files — written at runtime, never commit
uploads/

# Published OTA bundles — written at runtime by /ota/publish
ota-bundles/
uploads-test/
