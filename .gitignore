node_modules
.pnpm-store
.DS_Store
*.log
packages/*/node_modules
*.tsbuildinfo
coverage
dist

# pnpm content-addressable store (local package cache, hundreds of MB)
.pnpm-store/

# Environment files — all variants, keep only .env.example if one exists
.env*
!.env.example

# IDE
/.idea
/.vscode/*
!.vscode/extensions.json

# Build output
build/
_build
*/build-assets
*/build-chunks
.rsdoctor

# Playwright
/test-results/
/playwright-report/
.playwright-mcp/

# Local runtime secrets (never commit)
settings.json

# Local PM2 process config (machine-specific paths, never commit)
ecosystem.config.cjs

# Local Vite config override (never commit — overrides vite.config.ts in CI)
vite.config.js

# Misc local artifacts
my-submodule/*
.gitmodules
.meteor/local
**/.meteor/local-test/
current.md
pollenate-test-*.png

# Meteor build output and local packages
meteor-backend/prod-build/
meteor-backend/packages/
meteor-backend/.meteor/local/
meteor-backend/.meteor/local-test/

# Local development scripts and configs (machine-specific, never commit)
backend/nginx-apple-proxy.conf
meteor-backend/start-rosetta.sh

# Local working clone of github.com/mieweb/ui — tracked as a submodule and used
# to build vendor/mieweb-ui.tgz, which is what @mieweb/ui actually resolves to.
# Its build output is ignored; the submodule pointer itself stays tracked.
vendor/ui/dist/
vendor/ui/node_modules/

# Database backups (migration and production backups)
backups/
prod-backups/
backend/
backups/

# PulseVault + general uploaded files — written at runtime, never commit
uploads/
uploads-test/
